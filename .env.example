# Copy this file to .env (same folder) and fill in your keys.
# Expo exposes variables prefixed with EXPO_PUBLIC_.

# AWS serverless backend (optional; leave false to use local chat/device speech)
EXPO_PUBLIC_ENABLE_CLOUD_ASSISTANT=false
EXPO_PUBLIC_API_GATEWAY_URL=https://your-api-id.execute-api.your-region.amazonaws.com
EXPO_PUBLIC_AWS_REGION=us-east-1

# Firebase authentication
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MSG=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Speech-to-text fallback
EXPO_PUBLIC_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
